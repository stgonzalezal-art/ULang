# Copiar a /opt/ulang/.env y completar. NO subir a git.

# Puerto del servidor HTTP
PORT=8080

# Comando de IA headless para el agente nocturno
OPENCODE_CMD=opencode run
OPENCODE_MODEL=opencode/big-pickle

# Clave del proveedor del modelo (la usa opencode, no la expongas en logs)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
